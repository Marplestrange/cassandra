# Cassandra (09-10) — les sites : force brute WordPress et sondes d'effraction. Jamais la maison, le tailnet ni
# l'adresse publique de la box (un visiteur de la maison sort par elle).
[DEFAULT]
bantime.increment = true
bantime.maxtime = 30d

[cassandra-wordpress]
enabled  = true
port     = http,https
filter   = cassandra-wordpress
logpath  = /var/www/*/data/logs/*-frontend.access.log
maxretry = 3
findtime = 1h
bantime  = 1d
ignoreip = 127.0.0.1/8 ::1 192.168.1.0/24 100.64.0.0/10 fd7a:115c:a1e0::/48 198.51.100.7

[cassandra-sondes]
enabled  = true
port     = http,https
filter   = cassandra-sondes
logpath  = /var/www/*/data/logs/*-frontend.access.log
maxretry = 2
findtime = 1h
bantime  = 1d
ignoreip = 127.0.0.1/8 ::1 192.168.1.0/24 100.64.0.0/10 fd7a:115c:a1e0::/48 198.51.100.7
