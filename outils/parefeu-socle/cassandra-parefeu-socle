#!/usr/bin/env bash
# LE SOCLE DU PARE-FEU (09-10) — ce que FastPanel ne sait pas dire, et sans quoi « refuser par défaut » casse :
#   - les réponses aux connexions qu'ouvre la machine (avant toute autre règle : DNS, mises à jour, courriel) ;
#   - la boucle locale, Tailscale (tout le parc), les réseaux Docker vers la machine ;
#   - les adresses locales du parc (le témoin d'Athena interroge Orion par son adresse locale) ;
#   - les réponses DHCP de la box ; le ping depuis le réseau local ;
#   - en IPv6 : ICMPv6 entier (sans lui, voisinage et annonces de routeur tombent, et IPv6 avec), DHCPv6.
# Les sites (80/443) et la politique IPv4 vivent dans FastPanel : visibles et réglables dans son écran et dans
# l'onglet Sécurité de Cassandra. La politique IPv6, que FastPanel ne règle pas, se règle ici.
# Idempotent : relancé toutes les deux minutes, il remet le socle si Docker, Tailscale ou FastPanel réécrivent INPUT.
set -u
CONF=/etc/cassandra/parefeu-socle.conf
PARC4=""; RESEAU4=""; RESEAU6=""; BOX4=""; POLITIQUE6=ACCEPT
[ -r "$CONF" ] && . "$CONF"

socle() {   # $1 = iptables | ip6tables
    # Construit à part, puis substitué d'un coup s'il diffère : jamais d'instant où la chaîne active est vide.
    local T=$1 ACTIF=cassandra_socle C=cassandra_socle_neuf
    $T -w -N $ACTIF 2>/dev/null || true
    $T -w -N $C 2>/dev/null || true
    $T -w -F $C
    $T -w -A $C -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
    $T -w -A $C -i lo -j ACCEPT
    $T -w -A $C -i tailscale0 -j ACCEPT
    $T -w -A $C -i docker0 -j ACCEPT
    $T -w -A $C -i br-+ -j ACCEPT
    if [ "$T" = iptables ]; then
        for a in $PARC4; do $T -w -A $C -s "$a" -j ACCEPT; done
        [ -n "$BOX4" ] && $T -w -A $C -s "$BOX4" -p udp --sport 67 --dport 68 -j ACCEPT
        [ -n "$RESEAU4" ] && $T -w -A $C -s "$RESEAU4" -p icmp --icmp-type echo-request -j ACCEPT
        # Les réponses SSDP (découverte des appareils : pont Hue…) : elles viennent d'une autre adresse que
        # celle interrogée (multidiffusion), le suivi de connexion ne les reconnaît pas comme des réponses.
        [ -n "$RESEAU4" ] && $T -w -A $C -s "$RESEAU4" -p udp --sport 1900 -j ACCEPT
        # Le DNS local (10-10) : la maison résout les sites d'Orion vers son adresse locale.
        [ -n "$RESEAU4" ] && $T -w -A $C -s "$RESEAU4" -p udp --dport 53 -j ACCEPT
        [ -n "$RESEAU4" ] && $T -w -A $C -s "$RESEAU4" -p tcp --dport 53 -j ACCEPT
    else
        $T -w -A $C -p ipv6-icmp -j ACCEPT
        $T -w -A $C -s fe80::/10 -p udp --dport 546 -j ACCEPT
        # Le DNS local en IPv6 : la box annonce un DNS IPv6 aux appareils, qu'ils préfèrent souvent.
        for a in $RESEAU6; do
            $T -w -A $C -s "$a" -p udp --dport 53 -j ACCEPT
            $T -w -A $C -s "$a" -p tcp --dport 53 -j ACCEPT
        done
    fi
    $T -w -A $C -j RETURN
    if [ "$($T -w -S $C | sed "s/$C/X/")" = "$($T -w -S $ACTIF | sed "s/$ACTIF/X/")" ]; then
        $T -w -F $C; $T -w -X $C
    else
        # Le saut vers la neuve d'abord, puis l'ancienne retirée ; renommer garde les sauts (ils suivent la chaîne).
        local p
        p=$($T -w -S INPUT | grep '^-A INPUT' | grep -n -x -- "-A INPUT -j $ACTIF" | head -1 | cut -d: -f1)
        [ -n "$p" ] && $T -w -I INPUT "$p" -j $C
        while $T -w -C INPUT -j $ACTIF 2>/dev/null; do $T -w -D INPUT -j $ACTIF; done
        $T -w -F $ACTIF; $T -w -X $ACTIF
        $T -w -E $C $ACTIF
    fi
    C=$ACTIF
    # Le saut, une seule fois, APRÈS Tailscale et fail2ban : une adresse bannie ne doit pas garder sa connexion
    # ouverte grâce à « déjà établie ».
    # Déjà à sa place (une seule fois, juste après) : on n'y touche pas. Le retirer pour le reposer laissait un
    # instant sans socle, qu'un relevé du Sensorium attrapait (« ABSENT en IPv6 », 10-10).
    local regles pos der
    regles=$($T -w -S INPUT | grep '^-A INPUT')
    pos=$(echo "$regles" | grep -n -x -- "-A INPUT -j $C" | cut -d: -f1 | tr '\n' ' ')
    der=$(echo "$regles" | grep -v -x -- "-A INPUT -j $C" | grep -n -E -- '-j (ts-input|f2b-[^ ]+)$' | tail -1 | cut -d: -f1)
    [ "$pos" = "$(( ${der:-0} + 1 )) " ] && return 0
    while $T -w -C INPUT -j $C 2>/dev/null; do $T -w -D INPUT -j $C; done
    $T -w -I INPUT $(( ${der:-0} + 1 )) -j $C
}

socle iptables
socle ip6tables
case "$POLITIQUE6" in DROP|ACCEPT) ip6tables -w -P INPUT "$POLITIQUE6" ;; esac
exit 0
